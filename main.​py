# ─── User Data ───
users = {}

def get_user(user_id):
    if user_id not in users:
        users[user_id] = {
            "coins": 1000,
            "gems": 10,
            "level": 1,
            "xp": 0,
            "cards": [],
            "total_cards": 0,
            "daily_claimed": None,
            "premium_edition": False,
            "total_premium_cards": 0
        }
    return users[user_id]

def format_card(name, rarity, level=1, qty=1):
    r = RARITY.get(rarity, RARITY["Common"])
    border_style = "✦" if rarity == "Premium" else "═"
    border_line = border_style * 38
    
    # Premium edition special border
    if rarity == "Premium":
        return (
            f"👑══════════════════════════════👑\n"
            f"  {r['emoji']} ★ {r['name']} ★ {r['emoji']}\n"
            f"  ✦ {name} ✦\n"
            f"  ʟᴠʟ {level} ✦ ǫᴛʏ {qty}\n"
            f"  💎 ᴘʀᴇᴍɪᴜᴍ ᴇᴅɪᴛɪᴏɴ 💎\n"
            f"👑══════════════════════════════👑"
        )
    
    return (
        f"{border_line}\n"
        f"  {r['emoji']} {r['name']} {r['emoji']}\n"
        f"  ✦ {name} ✦\n"
        f"  ʟᴠʟ {level} ✦ ǫᴛʏ {qty}\n"
        f"{border_line}"
    )

