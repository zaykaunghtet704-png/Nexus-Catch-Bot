# ─── /daily ───
@dp.message(Command("daily"))
async def daily_cmd(msg: types.Message):
    user = get_user(msg.from_user.id)
    now = datetime.now()
    if user["daily_claimed"] and (now - user["daily_claimed"]) < timedelta(hours=24):
        left = timedelta(hours=24) - (now - user["daily_claimed"])
        h = int(left.total_seconds() // 3600)
        m = int((left.total_seconds() % 3600) // 60)
        await msg.answer(f"{E['clock']} **ᴀʟʀᴇᴀᴅʏ ᴄʟᴀɪᴍᴇᴅ!**\n  ɴᴇxᴛ: {h}ʜ {m}ᴍ", parse_mode="Markdown")
        return
    bonus = 500 + (user["level"] * 50)
    user["coins"] += bonus
    user["daily_claimed"] = now
    await msg.answer(f"{E['party']} **ᴅᴀɪʟʏ ʀᴇᴡᴀʀᴅ!**\n  🪙 +{bonus}", parse_mode="Markdown")

# ─── /drop ───
@dp.message(Command("drop"))
async def drop_cmd(msg: types.Message):
    user = get_user(msg.from_user.id)
    
    # Build weighted drop list
    drop_pool = []
    for rarity, data in RARITY.items():
        weight = int(data["drop_weight"] * 100) if rarity != "Premium" else 1
        drop_pool.extend([rarity] * weight)
    
    rarity = random.choice(drop_pool)
    name = random.choice(CARD_NAMES.get(rarity, ["Unknown"]))
    
    # Check if card already exists
    found = False
    for c in user["cards"]:
        if c["name"] == name:
            c["qty"] += 1
            found = True
            break
    if not found:
        user["cards"].append({
            "id": f"c{random.randint(1000,9999)}", 
            "name": name, 
            "rarity": rarity, 
            "level": 1, 
            "qty": 1
        })
    
    user["total_cards"] = sum(c["qty"] for c in user["cards"])
    if rarity == "Premium":
        user["total_premium_cards"] += 1
        user["premium_edition"] = True
    
    await msg.answer(
        f"{E['box']} **ᴄᴀʀᴅ ᴅʀᴏᴘᴘᴇᴅ!** {E['box']}\n"
        f"{format_card(name, rarity)}",
        parse_mode="Markdown"
    )

# ─── /collection ───
@dp.message(Command("collection"))
async def collection_cmd(msg: types.Message):
    user = get_user(msg.from_user.id)
    if not user["cards"]:
        await msg.answer(f"{E['cross']} **ʏᴏᴜʀ ᴄᴏʟʟᴇᴄᴛɪᴏɴ ɪꜱ ᴇᴍᴘᴛʏ!**\nᴜꜱᴇ /drop ᴛᴏ ɢᴇᴛ ᴄᴀʀᴅꜱ", parse_mode="Markdown")
        return
    
    # Sort by rarity (highest first)
    sorted_cards = sorted(user["cards"], key=lambda x: RARITY_ORDER.index(x["rarity"]), reverse=True)
    
    text = f"{E['card']} **ʏᴏᴜʀ ᴄᴏʟʟᴇᴄᴛɪᴏɴ** {E['card']}\n"
    text += f"👑 Premium: {user['total_premium_cards']}\n"
    text += f"{BORDER['main']}\n"
    
    for i, c in enumerate(sorted_cards[:20]):
        rarity_emoji = RARITY.get(c["rarity"], {}).get("emoji", "⬜")
        is_premium = " 👑" if c["rarity"] == "Premium" else ""
        text += f"  {i+1}. {rarity_emoji} {c['name']}{is_premium} [{c['qty']}] ʟᴠʟ{c['level']}\n"
    
    if len(user["cards"]) > 20:
        text += f"\n*... ᴀɴᴅ {len(user['cards']) - 20} ᴍᴏʀᴇ*"
    text += f"\n{BORDER['main']}"
    await msg.answer(text, parse_mode="Markdown")

