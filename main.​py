# ─── /rarity ───
@dp.message(Command("rarity"))
async def rarity_cmd(msg: types.Message):
    text = f"{E['crown']} **ʀᴀʀɪᴛʏ ʟᴇᴠᴇʟꜱ** {E['crown']}\n{BORDER['main']}\n"
    for i, rarity in enumerate(RARITY_ORDER, 1):
        r = RARITY.get(rarity, {})
        emoji = r.get("emoji", "⬜")
        weight = r.get("drop_weight", 0)
        stars = "★" * min(5, int(weight / 2)) if weight >= 1 else "☆"
        is_premium = " 👑 PREMIUM" if rarity == "Premium" else ""
        text += f"  {i}. {emoji} **{rarity}**{is_premium}\n"
        text += f"     drop: {stars}\n"
    text += f"{BORDER['main']}"
    text += f"\n*💎 Premium is the rarest & most powerful!*"
    await msg.answer(text, parse_mode="Markdown")

